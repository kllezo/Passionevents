# ─── Required ────────────────────────────────────────────────────────────────
# Database. SQLite for local/dev; use a hosted Postgres/MySQL URL in production
# (change `provider` in prisma/schema.prisma accordingly).
DATABASE_URL="file:./dev.db"

# 32+ random characters used to sign admin session cookies.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Public canonical URL (used for SEO, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# ─── Admin bootstrap (used once by `npm run admin:create`) ───────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ─── Business contact (leave blank to hide the element on the site) ──────────
# International format without + or spaces, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""

# ─── Optional enquiry notifications (Resend — https://resend.com) ────────────
# When both are set, every new enquiry is also emailed. Otherwise enquiries are
# only stored in the database and visible in /admin/enquiries.
RESEND_API_KEY=""
ENQUIRY_NOTIFY_TO=""
ENQUIRY_NOTIFY_FROM="Passion Events <enquiries@your-verified-domain.com>"

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Directory where admin uploads are stored (must be persistent in production).
UPLOAD_DIR="./uploads"
