# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL. On Vercel these come from the Neon integration; locally run
# `vercel env pull .env.local` or point them at any Postgres database.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# 32+ random characters used to sign admin session cookies.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Public canonical URL (used for SEO, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# ─── Admin bootstrap (used once by `npm run admin:create`) ───────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ─── Business contact (leave blank to hide the element on the site) ──────────
# International format without + or spaces, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to load no analytics.
NEXT_PUBLIC_GA_ID=""

# ─── Optional enquiry notifications (Resend — https://resend.com) ────────────
# When both are set, every new enquiry is also emailed. Otherwise enquiries are
# only stored in the database and visible in /admin/enquiries.
RESEND_API_KEY=""
ENQUIRY_NOTIFY_TO=""
ENQUIRY_NOTIFY_FROM="Passion Events <enquiries@your-verified-domain.com>"

# ─── Uploads ─────────────────────────────────────────────────────────────────
# Vercel Blob token (set automatically when the Blob store is linked). When set,
# uploads go to Blob; otherwise to UPLOAD_DIR on local disk.
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./uploads"
