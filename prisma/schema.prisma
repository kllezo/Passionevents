// Passion Events data model.
// SQLite for local development. To move to Postgres/MySQL in production change
// `provider` + DATABASE_URL and run `npx prisma migrate deploy` (see docs/DEPLOYMENT.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?
}

/// One event model powers BOTH public listings:
///   experience = "EVENTS" -> /portfolio (Passion Events work)
///   experience = "LIVE"   -> /concerts (upcoming shows + past experiences + artists)
/// Only rows with status = "PUBLISHED" are ever read by public pages.
model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  experience  String    @default("LIVE") // EVENTS | LIVE
  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  eventStatus String    @default("ANNOUNCED") // ANNOUNCED | ON_SALE | SOLD_OUT | POSTPONED | CANCELLED | COMPLETED
  category    String    @default("CONCERT") // WEDDING | CORPORATE | PRIVATE | DESTINATION | CONCERT | PRODUCTION | OTHER
  title       String
  artists     String    @default("") // comma separated, only verified names
  summary     String    @default("")
  description String    @default("")
  venue       String    @default("")
  city        String    @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  posterUrl   String?
  coverUrl    String?
  bookingUrl  String?
  featured    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  media       Media[]

  @@index([experience, status, startsAt])
}

model Media {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId, sortOrder])
}

model Enquiry {
  id         String   @id @default(cuid())
  fullName   String
  phone      String
  email      String
  category   String
  eventDate  DateTime?
  location   String   @default("")
  guestCount Int?
  budget     String   @default("")
  services   String   @default("[]") // JSON array of service keys
  details    String   @default("")
  source     String   @default("events") // events | live | partners
  status     String   @default("NEW") // NEW | CONTACTED | CLOSED
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}
